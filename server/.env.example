# ===== 密码本后端环境变量（复制为 .env 后修改，.env 不会被提交） =====

# 服务监听
PORT=3100
HOST=127.0.0.1

# 运行环境：development | production | test
NODE_ENV=development

# 数据目录（相对仓库根目录，或绝对路径）
DATA_DIR=data

# 密钥模式：dev = DEK 落盘（可换主密码不重加密，默认）
#           strict = DEK 不落盘，主密码即字段密钥（更换主密码需全量重加密）
AUTH_MODE=dev

# 允许的跨域来源（逗号分隔），Web 开发期地址
CORS_ORIGINS=http://localhost:5173

# 日志级别：debug | info | warn | error
LOG_LEVEL=info

# ---- 以下为可选调优项（一般保持默认） ----
# PBKDF2 迭代次数（默认 310000，OWASP 建议；仅测试环境可调低）
#KDF_ITERATIONS=310000
# 敏感端点（setup/login/change-master）的 IP 限速开关，默认 false（不返回 429）。
# 关闭时暴力破解仍由「连续失败锁定」兜底（failedAttempts + lockMinutesAfterBan）。
#RATE_LIMIT_ENABLED=false
# 限速窗口毫秒数 / 窗口内最大次数（仅在 RATE_LIMIT_ENABLED=true 时生效）
#RATE_LOGIN_WINDOW_MS=300000
#RATE_LOGIN_MAX=5
# 会话时长初值（秒）。仅在 data/config.json 尚无 lockMinutes 时作为其初值，
# 之后运行期以「系统设置」里的会话时长（lockMinutes）为准。
#ACCESS_TOKEN_TTL=1800
# 刷新令牌有效期（秒，默认 7 天）
#REFRESH_TOKEN_TTL=604800
# 结构化日志是否落盘（默认 true），落盘位置 <DATA_DIR>/logs/app-YYYYMMDD.log
#LOG_TO_FILE=true
# 日志文件保留天数（默认 14，超期在启动时清理）
#LOG_RETENTION_DAYS=14
# 反向代理后置 true（信任 X-Forwarded-*）
#TRUST_PROXY=false
