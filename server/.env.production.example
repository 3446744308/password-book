# ============================================================================
# 生产环境配置模板 —— 「用 服务器IP + 端口 直连」部署方式（不使用 Nginx 反代）
# ============================================================================
#
# 用法（在服务器上）：
#   cp server/.env.production.example server/.env
#   chmod 600 server/.env
#   然后按需修改，再启动 node server/src/server.js
#
# .env 已被 .gitignore 忽略，不会进版本库。
#
# ⚠️ 这套方式没有 TLS：主密码在 POST /auth/login 请求体里是**明文过网**的。
#    仅适用于内网、或你完全信任的链路。要对外提供服务请改用 Nginx + HTTPS
#    （见 docs/04 的「方案 A」）。
# ============================================================================

# ===== 监听 =====
# HOST 必须是 0.0.0.0：默认的 127.0.0.1 只监听回环，用服务器 IP 访问会「连接被拒」
HOST=0.0.0.0
PORT=3100
NODE_ENV=production

# ===== 数据目录 =====
# 建议用仓库之外的绝对路径，避免误删/误打包；相对路径按仓库根解析
# DATA_DIR=/var/lib/password-book/data

# ===== 密钥模式 =====
# 对外暴露必须 strict：dev 模式下明文数据密钥会写进 data/secrets.json，
# 拿到 data/ 目录的人可直接解密全部密码。
# 注意：只对「首次初始化」生效；已有库以 data/secrets.json 里的 mode 为准，
#       想把 dev 库换成 strict 只能重建库（详见 docs/04 §5）。
AUTH_MODE=strict

# ===== 反向代理 =====
# 直连不经过任何代理，必须保持 false。
# 设为 true 会让 req.ip 取 X-Forwarded-For（这里没人会设置它），
# 审计日志与「按 IP 限速」都会记错来源。
TRUST_PROXY=false

# ===== 跨域 =====
# 前后端同源（web/dist 由本服务托管），留空即可。
# 只有把前端单独部署到别的域名/端口时才需要填，逗号分隔，禁止 *
# CORS_ORIGINS=

# ===== 会话 =====
# 刷新令牌有效期（秒）。它决定「刷新页面免密」的窗口，默认 7 天。
# 没有 HTTPS 时 Cookie 无法加 Secure，建议收敛到 8 小时：28800
# REFRESH_TOKEN_TTL=28800

# ===== 登录保护 =====
# 失败锁定是默认生效的（默认 5 次失败锁 15 分钟）。
# 需要额外的按 IP 频率限制时再打开；关闭状态下不会返回 429。
# RATE_LIMIT_ENABLED=true

# ===== 日志 =====
# 结构化日志落在 <DATA_DIR>/logs/app-YYYYMMDD.log，保留 14 天
LOG_LEVEL=info
