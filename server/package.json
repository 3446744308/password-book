{
  "name": "password-book-server",
  "version": "1.0.0",
  "description": "密码本系统后端：Express + JSON 文件存储 + 字段加密",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore --config ../.prettierrc.json",
    "format:check": "prettier --check . --ignore-path ../.prettierignore --config ../.prettierrc.json",
    "backup": "node ../scripts/backup.js",
    "scan": "node ../scripts/scan-plaintext.js",
    "check:api-doc": "node ../scripts/check-api-doc.js"
  },
  "dependencies": {
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.10.1",
    "vitest": "^3.0.0"
  }
}
