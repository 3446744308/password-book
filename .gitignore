# 依赖
node_modules/

# 构建产物
dist/
build/

# 数据目录（永不提交，仅保留占位）
data/*
!data/.gitkeep

# 环境变量实体文件
.env
.env.local

# 日志与备份
*.log
logs/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 测试覆盖
coverage/

# 打包 / 归档文件
# 注意：项目压缩包极易把 data/（含 secrets.json 明文密钥、jwt.secret、master.json）
# 一起装进去，一旦提交就等于泄漏整库解密能力，故一律不入库。
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
